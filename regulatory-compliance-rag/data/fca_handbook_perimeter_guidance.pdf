<section  class="component featured-cols fca-colour three-columns-block fca-colour--ffffff text-left fca-about fca-colour-underlined--ff585d">
  <div class="container">
          <h2 class="featured-cols__title fca-colour__foundation">						What we do
			</h2>
              <p class="h3 featured-cols__sub-title fca-colour__foundation-swatch">						We regulate financial services firms and markets in the UK, setting standards for firms to meet and holding them to account if they don&#039;t. Find out more about our work.
			</p>
        <div class="featured-cols__row clearfix fca-colour__foundation-swatch">
              <div
          class="col-xs-12 col-md-4 featured-cols__col ">
          <div class="featured-cols__top ">
            <div class="featured-cols__border fca-colour__foundation"></div>
                                      <div class="featured-text">
                <h2 class="h4 heading__underline">About us</h2>
                <p>We aim to support a healthy and successful financial system, so consumers get a fair deal.</p>
                <a class="btn btn--arrow-right" href="/about" aria-label="Our role - About us">Our role</a>
              </div>
                                  </div>
        </div>
              <div
          class="col-xs-12 col-md-4 featured-cols__col featured-cols__col--middle fca-colour--ffffff-border">
          <div class="featured-cols__top ">
            <div class="featured-cols__border fca-colour__foundation"></div>
                                      <div class="featured-text">
                <h2 class="h4 heading__underline">Publications</h2>
                <p>Have your say on our live consultations, or browse our final rules and other resources.</p>
                <a class="btn btn--arrow-right" href="/publications" aria-label="Our publications - Publications">Our publications</a>
              </div>
                                  </div>
        </div>
              <div
          class="col-xs-12 col-md-4 featured-cols__col ">
          <div class="featured-cols__top ">
            <div class="featured-cols__border fca-colour__foundation"></div>
                                      <div class="featured-text">
                <h2 class="h4 heading__underline">Join us</h2>
                <p>Our people work across law, insurance, banking, policy, technology services and more.</p>
                <a class="btn btn--arrow-right" href="/careers" aria-label="How to apply - Join us">How to apply</a>
              </div>
                                  </div>
        </div>
          </div>
  </div>
</section>

