{"source_id": "gdpr-core", "source_name": "gdpr-core.txt", "chunk_id": "gdpr-core-chunk-1", "regulation_title": "gdpr-core.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general", "text": "Personal data must be processed lawfully, fairly, and transparently. Consent or another lawful basis is required before using customer data.", "metadata": {"source_name": "gdpr-core.txt", "regulation_title": "gdpr-core.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general"}}
{"source_id": "internal-policy", "source_name": "internal-policy.txt", "chunk_id": "internal-policy-chunk-1", "regulation_title": "internal-policy.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general", "text": "Internal policy prohibits trading strategies that use customer personal data for targeting without explicit consent and legal review.", "metadata": {"source_name": "internal-policy.txt", "regulation_title": "internal-policy.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general"}}
{"source_id": "mifid-ii-best-execution", "source_name": "mifid-ii-best-execution.txt", "chunk_id": "mifid-ii-best-execution-chunk-1", "regulation_title": "mifid-ii-best-execution.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general", "text": "MiFID II requires firms to take all sufficient steps to obtain the best possible result for clients when executing orders.", "metadata": {"source_name": "mifid-ii-best-execution.txt", "regulation_title": "mifid-ii-best-execution.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general"}}
{"source_id": "mifid-ii-suitability", "source_name": "mifid-ii-suitability.txt", "chunk_id": "mifid-ii-suitability-chunk-1", "regulation_title": "mifid-ii-suitability.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general", "text": "Suitability assessments are required before recommending financial instruments to retail clients.", "metadata": {"source_name": "mifid-ii-suitability.txt", "regulation_title": "mifid-ii-suitability.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general"}}
{"source_id": "sec-rule-1", "source_name": "sec-rule-1.txt", "chunk_id": "sec-rule-1-chunk-1", "regulation_title": "sec-rule-1.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general", "text": "Market abuse, insider trading, and front-running are prohibited. Firms must maintain controls to prevent use of material nonpublic information.", "metadata": {"source_name": "sec-rule-1.txt", "regulation_title": "sec-rule-1.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general"}}
{"source_id": "sec-rule-2", "source_name": "sec-rule-2.txt", "chunk_id": "sec-rule-2-chunk-1", "regulation_title": "sec-rule-2.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general", "text": "Investment advisers must act in the best interests of clients and document conflicts of interest affecting trading recommendations.", "metadata": {"source_name": "sec-rule-2.txt", "regulation_title": "sec-rule-2.txt", "jurisdiction": "unknown", "effective_date": "unknown", "section": "general"}}
